{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/auth/token", "dest": "/api/auth/token.ts" },
    { "src": "/api/auth/refresh", "dest": "/api/auth/refresh.ts" },
    { "src": "/api/proxy/(.*)", "dest": "/api/proxy/[...path].ts" }
  ]
}
